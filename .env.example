# Use a Neon PostgreSQL connection string for shared job history.
# Leave DATABASE_URL empty to use local SQLite at logs/applications.db.
DATABASE_URL=

# API credentials (never commit the real .env file)
GROQ_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM router settings; the code defaults may be used instead.
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_MAX_OUTPUT_TOKENS=300
# GROQ_REQUEST_TIMEOUT=45